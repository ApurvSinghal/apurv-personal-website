{
  "name": "apurv-personal-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint --config config/eslint.config.mjs .",
    "start": "next start",
    "clean": "rm -rf .next .vercel test-results tsconfig.tsbuildinfo",
    "test": "pnpm test:all",
    "test:all": "pnpm test:unit && pnpm test:api && pnpm test:component && pnpm test:smoke && pnpm test:e2e && pnpm test:a11y",
    "test:unit": "vitest --config config/vitest.config.ts run src/tests/unit",
    "test:api": "vitest --config config/vitest.config.ts run src/tests/api",
    "test:component": "vitest --config config/vitest.config.ts run src/tests/components",
    "test:smoke": "playwright test --config config/playwright.config.ts src/tests/e2e/smoke.spec.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts src/tests/e2e/navigation.spec.ts src/tests/e2e/contact.spec.ts",
    "test:a11y": "playwright test --config config/playwright.config.ts src/tests/e2e/a11y.spec.ts",
    "x:post": "node scripts/x-poster/index.ts",
    "x:test": "node scripts/x-poster/index.ts --dry-run"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.11",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@sentry/nextjs": "^10.73.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.9.3",
    "tailwind-merge": "^3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3.3.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "next": ">=16.2.11",
      "vite": "8.2.2",
      "vitest>vite": "8.2.2",
      "@vitest/mocker>vite": "8.2.2",
      "undici": "^7.29.0",
      "sharp": "^0.35.0",
      "postcss": "^8.5.23",
      "nanoid": "^3.3.18",
      "browserslist": "^4.28.7",
      "fast-uri": "^3.1.6",
      "js-yaml": "^4.3.1",
      "@opentelemetry/core": ">=2.11.0",
      "@babel/core": "^7.29.1",
      "brace-expansion": "1.1.18",
      "glob>minimatch>brace-expansion": "5.0.9",
      "flatted": ">=3.4.2",
      "picomatch@^2.0.0": ">=2.3.2"
    }
  }
}
