{
  "name": "apurv-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint --config config/eslint.config.mjs .",
    "start": "next start",
    "clean": "node -e \"['.next', '.vercel', 'test-results', 'coverage', 'tsconfig.tsbuildinfo'].forEach(p => fs.rmSync(p, { recursive: true, force: true }))\"",
    "test": "vitest --config config/vitest.config.mjs run src/tests",
    "x:post": "node --no-warnings scripts/x-poster/index.ts",
    "x:test": "node --no-warnings scripts/x-poster/index.ts --dry-run"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "applicationinsights": "^3.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "newrelic": "^14.5.1",
    "next": "^16.3.7",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.31.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/newrelic": "^9.14.8",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.7",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.4.0",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
